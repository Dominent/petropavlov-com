{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 7 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/blog/ab-testing-a-portfolio-that-gets-20-visits-a-day",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.petropavlov.dev" }],
      "destination": "https://petropavlov.dev/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/admin/analytics", "destination": "/api/admin/analytics" },
    { "source": "/admin/speed", "destination": "/api/admin/speed" },
    { "source": "/admin/events", "destination": "/api/admin/events" },
    { "source": "/admin/marketing", "destination": "/api/admin/marketing" },
    { "source": "/cv", "destination": "/api/cv" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/og.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }
      ]
    },
    {
      "source": "/petro.avif",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/petro.webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/petro.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
